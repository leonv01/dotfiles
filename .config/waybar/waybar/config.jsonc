// -*- mode: jsonc -*-
[{
    "output": "DP-1",
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 40,// Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [
        "clock",
        "custom/weather"
    ],
    "modules-right": [
        "temperature",
        "custom/disks",
        "custom/media",
        "pulseaudio",
        "tray"
    ],
    "hyprland/workspaces": {
        "format": "{name}"
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        "timezone": "Europe/Berlin",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M %d. %B}",
        "interval": 60
    },
    "cpu": {
        "format": "{usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "{used:0.1f}GiB"
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 85,
        "warning-threshold": 75,
        "format-critical": "{temperatureC}°C ",
        "format-warning": "{temperatureC}°C ",
        "format": "{temperatureC}°C"
    },
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source} ",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",  
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": " {text}",
        "return-type": "json",
        "max-length": 25,
        "interval": 0,
        "escape": false,
        /*"exec": "/usr/bin/python3 ~/.config/waybar/modules/mediaplayer.py --player spotify 2> /dev/null" */
        "exec": "~/.config/waybar/modules/current_spotify.sh",
        "on-click": "playerctl play-pause"
    },
    "custom/power": {
        "format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    },
    "disk": {
        "path": "/",
        "interval": 30,
        "format": " {free}",
        "on-click": "thunar /"
    },
    "disk#mount1": {
        "path": "/mnt/disk1",
        "interval": 30,
        "format": " {free}",
        "on-click": "thunar /mnt/disk1/"
    },
    "disk#mount2": {
        "path": "/mnt/disk2",
        "interval": 30,
        "format": " {free}",
        "on-click": "thunar /mnt/disk2/"
    },
    "network": {
        "interface": "enp34s0",
        "format": "{bandwidthUpBits}↑ {bandwidthDownBits}↓",
        "tooltip-format": "{ifname}"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "tooltip": true,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "active-first": true
    },
    "custom/weather": {
        "exec": "~/.config/waybar/modules/weather.sh",
        "interval": 600,
        "format": "{}",
        "tooltip": false
    },
    "custom/nightlight": {
        "exec": "~/.config/waybar/modules/nightlight.sh",
        "interval": 30,
        "tooltip": true,
        "format": "{}",
        "format-icons": {
            "on": "🌙",
            "off": "☀️"
        },
        "on-click": "~/.config/waybar/modules/nightlight.sh toggle",
        "return-type": "json"
    },
    "custom/disks": {
        "exec": "/usr/bin/python3 ~/.config/waybar/modules/disks.py",
        "interval": 15,
        "format": "{}",
        "tooltip": true,
        "return-type": "json"
    }
},
{
    "layer": "top",
    "output": "DP-3",
    "modules-left": [
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "temperature"
    ]
}]

